# Single env file for the whole repo. Copy to .env (gitignored) and fill in.
# No AWS credentials here: export them from your SSO session.

# ===== AWS =====
AWS_REGION=eu-west-1

# ===== Strategist =====
# Bedrock cross-region inference profile, not a bare model ID
BEDROCK_MODEL_ID=eu.anthropic.claude-sonnet-4-6
LOG_LEVEL=INFO

# ===== Coordinator =====
COORDINATOR_MODEL_ID=eu.anthropic.claude-haiku-4-5-20251001-v1:0
# Your Slack member ID: DM recipient, only allowed sender
SLACK_USER_ID=

# ===== GitHub =====
# owner/repo and their immutable IDs; set automatically inside GitHub Actions
GITHUB_REPOSITORY=<owner>/juhta
GITHUB_REPOSITORY_OWNER_ID=
GITHUB_REPOSITORY_ID=
